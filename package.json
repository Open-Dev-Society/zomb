{
  "name": "zomb",
  "version": "0.0.1",
  "description": "A health check for AI-written codebases: security holes, zombie code, sprawl and architecture.",
  "type": "module",
  "bin": {
    "zomb": "dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "hooks",
    "skills",
    "action.yml",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "oxc-parser": "^0.150.0",
    "oxc-resolver": "^11.24.2",
    "yaml": "^2.9.1"
  },
  "knip": {
    "ignoreDependencies": [
      "jscpd"
    ],
    "entry": [
      "src/bin.ts",
      "cloud/server.js",
      "research/*.js",
      "test/*.test.js",
      "research/page.ts"
    ]
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
